<html>
    <head>
        <title>New Weapon Form</title>
    </head>

    <body>
        <form method='POST' action='/inventory/new'>
            <p>Weapon Name: </p>
            <input name='wName' type='text'>
            <p>Source Series: </p>
            <input name='series' type='text'>
            <p>Ammo Type: </p>
            <input name='ammo' type='text'>
            <p>Owners:</p>
            <div id='owners'>
            </div>
            <button type='button' id='add-owner'>Add Owner</button>
            <button type='submit'>Submit</button>
        </form>
    </body>

    <script>
            const owners = document.querySelector('#owners');
            const addBtn = document.querySelector('#add-owner');

            addBtn.addEventListener('click', () => {
                const owner = document.createElement('div');

                owner.classList.add('owner');

                owner.innerHTML = `
                    <p>Owner Name: </p>
                    <input name='oName' type='text'>
                    <button type='button' class='remove-owner'>Remove</button>
                `;

                owners.appendChild(owner);

                owner.querySelector('.remove-owner').addEventListener('click', () => {
                    owner.remove();
                });
            });
        </script>

</html>
