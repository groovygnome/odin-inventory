<p><%= weapon.name %></p>
<p><%= weapon.ammoType %></p>
<p><%= weapon.series %></p>
<ul>
<% weapon.owners.forEach(owner => { %>
    <li><%= owner %></li>
<% }); %>
</ul>
<a href='./inventory/weapon/<%=weapon.id%>'>Weapon Details</a>
<form method='POST' action='/inventory/delete/<%=weapon.id%>'>
    <button type='submit'>Delete <%=weapon.name %></button>
</form>
