<!DOCTYPE html>
<html>
    <head>
        <title>The Arsenal</title>
    </head>
    <body>
        <h1>The Arsenal</h1>
        <ul>
            <% let seriesSet = new Set() %>
            <% inventory.forEach((weapon) => { %>
                <% if(!seriesSet.has(weapon.series)){ %>
                    <li><a href='/inventory/series/<%= weapon.series %>'><%= weapon.series %></a></li>
                    <% seriesSet.add(weapon.series) %>
            <% }}); %>
        </ul>
        <%- include('./partials/error.ejs') %>
        <ul>
            <% inventory.forEach((weapon) => { %>
                <li>
                    <%- include('./partials/weapon.ejs', {weapon: weapon}) %>
                </li>
            <% }); %>
        </ul>

        <a href='/new'>Add a New Weapon</a>
    </body>
</html>
